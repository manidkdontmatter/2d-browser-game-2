{
  "name": "2d-browser-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm-run-all --parallel dev:server dev:client",
    "dev:client": "vite --host 127.0.0.1",
    "dev:server": "tsx watch src/server/main.ts",
    "build": "npm-run-all build:shared build:server build:client",
    "build:shared": "tsc -p tsconfig.shared.json",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "diagnose:loop": "tsx src/server/diagnostics/runLoopTimingDiagnostic.ts",
    "diagnose:net:aoi": "tsx src/server/diagnostics/runNetAoiDiagnostic.ts",
    "diagnose:net:commands": "tsx src/server/diagnostics/runNetCommandDiagnostic.ts",
    "diagnose:scale": "tsx src/server/diagnostics/runScalabilityDiagnostic.ts",
    "diagnose:scale:cpu": "node --cpu-prof --cpu-prof-dir=output --import tsx src/server/diagnostics/runScalabilityDiagnostic.ts",
    "diagnose:scale:heap": "node --heap-prof --heap-prof-dir=output --import tsx src/server/diagnostics/runScalabilityDiagnostic.ts"
  },
  "dependencies": {
    "@pixi/tilemap": "^5.0.2",
    "better-sqlite3": "^11.9.1",
    "bitecs": "^0.4.0",
    "nengi": "^2.0.0-alpha.173",
    "nengi-buffers": "^0.5.0",
    "nengi-dataviews": "^0.4.0",
    "nengi-uws-instance-adapter": "^0.6.0",
    "nengi-websocket-client-adapter": "^0.7.0",
    "pixi.js": "^8.18.1",
    "skale-physics": "github:manidkdontmatter/SKALE-Physics"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.3",
    "npm-run-all": "^4.1.5",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.4",
    "vitest": "^3.1.2"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
